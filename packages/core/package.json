{
  "name": "@image-ultra/core",
  "version": "0.0.0",
  "description": "Framework-agnostic, typed image editing engine for image-ultra.",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "internal": [
        "./dist/internal.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./internal": {
      "import": {
        "types": "./dist/internal.d.ts",
        "default": "./dist/internal.js"
      },
      "require": {
        "types": "./dist/internal.d.cts",
        "default": "./dist/internal.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "image-editor",
    "image",
    "editor",
    "crop",
    "filters",
    "typescript"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "immer": "^11.1.18",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "6.0.3",
    "vitest": "^5.0.1"
  }
}
