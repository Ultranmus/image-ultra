{
  "name": "@image-ultra/react",
  "version": "0.1.0",
  "description": "Premium, fully typed image editor component for React and Next.js.",
  "license": "MIT",
  "author": "Ultranmus",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ultranmus/image-ultra.git",
    "directory": "packages/react"
  },
  "homepage": "https://imageultra.ashvattech.com",
  "bugs": {
    "url": "https://github.com/Ultranmus/image-ultra/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "react",
    "nextjs",
    "image-editor",
    "crop",
    "filters",
    "typescript"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "dependencies": {
    "@image-ultra/core": "workspace:*",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "emojibase-data": "17.0.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0",
    "tsup": "^8.5.1",
    "typescript": "6.0.3",
    "vitest": "^5.0.1"
  }
}
